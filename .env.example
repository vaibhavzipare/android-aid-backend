APP_ENV=dev

# Used only when swapping MockLLMService for a real Claude-backed service.
# CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Free Groq API key — get one at https://console.groq.com/keys (no credit
# card required). When set, the backend uses real LLM analysis instead of
# the rule-based mock.
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=llama-3.3-70b-versatile